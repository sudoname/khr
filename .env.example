# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL (docker-compose exposes 5434 to avoid clashing with local installs)
DATABASE_URL=postgresql://peopleflow:peopleflow@localhost:5434/peopleflow

# Redis (docker-compose exposes 6380)
REDIS_URL=redis://localhost:6380

# API
API_PORT=4000
# Comma-separated list of allowed browser origins (CSRF / CORS)
WEB_ORIGIN=http://localhost:3000
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-insecure-secret-change-me
# Set to 1 when serving over HTTPS
SECURE_COOKIES=0

# Per-company workspace subdomains (prod only — leave unset for local dev).
# BASE_DOMAIN/COOKIE_DOMAIN are read by the API; NEXT_PUBLIC_BASE_DOMAIN is
# baked into the web bundle at build time.
#BASE_DOMAIN=khr.ng
#COOKIE_DOMAIN=.khr.ng
#NEXT_PUBLIC_BASE_DOMAIN=khr.ng

# Google OAuth sign-in (optional). Create a Web OAuth client in Google Cloud
# Console with redirect URI: <WEB_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Mailhog in dev: UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="PeopleFlow HR <no-reply@peopleflow.local>"

# Web
NEXT_PUBLIC_APP_NAME=PeopleFlow HR
API_URL=http://localhost:4000

# Seed (local/dev only)
SEED_PLATFORM_ADMIN_EMAIL=root@peopleflow.local
SEED_PLATFORM_ADMIN_PASSWORD=ChangeMe-Please-123!
