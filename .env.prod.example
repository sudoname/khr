# Production env for docker-compose.prod.yml — copy to .env on the server.
# Generate secrets with: openssl rand -hex 32

# Owner-role password. Besides the postgres container itself, only the
# one-shot `migrate` service sees this (it applies DDL on deploy and exits);
# the long-lived api/worker containers never hold owner credentials.
POSTGRES_PASSWORD=

SESSION_SECRET=

# Password for the non-owner `khr_app` database role the api/worker connect as
# (Postgres row-level security applies to it, unlike the owner). One-time setup
# on the server, inside the postgres container:
#   ALTER ROLE khr_app PASSWORD '<APP_DB_PASSWORD>';
APP_DB_PASSWORD=

# Public origin of the site (used for CORS, CSRF and links in emails)
WEB_ORIGIN=https://khr.ng

# Per-company workspace subdomains (acme.khr.ng). Defaults are baked into
# docker-compose.prod.yml; override here only if the domain differs. Requires
# wildcard DNS + a *.khr.ng certificate on nginx.
#BASE_DOMAIN=khr.ng
#COOKIE_DOMAIN=.khr.ng

# Google OAuth sign-in (optional). Create a Web OAuth client in Google Cloud
# Console with authorized redirect URI: https://khr.ng/api/auth/google/callback
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# Real SMTP provider (leave unset to use the bundled Mailhog catcher)
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=KHR <no-reply@khr.ng>

# Optional: platform admin created by the seed script
#SEED_PLATFORM_ADMIN_EMAIL=
#SEED_PLATFORM_ADMIN_PASSWORD=
